<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello World!"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Our custom overlay view stacked on top of the PreviewView -->
    <com.hdekker.opencv_on_android.DrawingOverlay
        android:id="@+id/drawing_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView" />

    <LinearLayout
        android:id="@+id/metrics_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#80000000"
        android:padding="8dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Include the first metric item -->
        <include
            android:id="@+id/fps_metric"
            layout="@layout/metric_display_item" />

        <include
            android:id="@+id/point_metric"
            layout="@layout/metric_display_item" />

        <include
            android:id="@+id/contour_metric"
            layout="@layout/metric_display_item" />

        <include
            android:id="@+id/deflection_metric"
            layout="@layout/metric_display_item" />

        <include
            android:id="@+id/intersection_metric"
            layout="@layout/metric_display_item" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
